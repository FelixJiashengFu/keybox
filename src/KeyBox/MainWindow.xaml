<Window x:Class="KeyBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KeyBox.Core"
        Title="密钥匣" Width="1060" Height="700" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/KeyBox.ico">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="IconContent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
        </Style>
        <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource IconContent}" />
        </Style>
        <ContextMenu x:Key="EntryMenu">
            <MenuItem Header="复制 API Key" Click="MenuCopyClick" />
            <MenuItem Header="编辑" Click="MenuEditClick" />
            <Separator />
            <MenuItem Header="删除" Click="MenuDeleteClick" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!-- ============ Lock screen ============ -->
        <Grid x:Name="LockView">
            <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                <Image Source="pack://application:,,,/Assets/KeyBox.png" Width="84" Height="84"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="密钥匣" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock x:Name="LockSubtitle" Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,26" Text="输入主密码解锁" />

                <TextBlock Text="主密码" Style="{StaticResource Caption}" />
                <PasswordBox x:Name="MasterBox" KeyDown="PasswordKeyDown" />
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="再输入一次" Style="{StaticResource FieldCaption}" />
                    <PasswordBox x:Name="ConfirmBox" KeyDown="PasswordKeyDown" />
                </StackPanel>

                <TextBlock x:Name="LockError" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                <Button x:Name="UnlockButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Margin="0,18,0,0" Padding="0,8" Click="UnlockClick" Content="解锁" />
                <Button x:Name="QuickUnlockButton" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="0,8"
                        Click="QuickUnlockClick" Visibility="Collapsed" Content="用本机 Windows 账户解锁" />
                <TextBlock x:Name="CreateHint" Style="{StaticResource Secondary}" FontSize="12" Margin="0,16,0,0"
                           Visibility="Collapsed"
                           Text="主密码只用来在本机加密你的 Key（AES-256-GCM），不会保存在任何地方。忘记它就再也打不开密钥匣，请记牢。" />
            </StackPanel>
        </Grid>

        <!-- ============ Unlocked ============ -->
        <Grid x:Name="VaultView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- list -->
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,14,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,0,14">
                        <Image Source="pack://application:,,,/Assets/KeyBox.png" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Secondary}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="密钥匣" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="34,6,10,6" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SearchHint" Text="搜索名称、服务商、变量名…" Margin="35,0,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <ListBox x:Name="EntryList" Grid.Row="2" SelectionChanged="EntrySelected" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource EntryMenu}" />
                                <EventSetter Event="MouseDoubleClick" Handler="EntryDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:ApiEntry}">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Color}">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ListHint" Grid.Row="2" Style="{StaticResource Secondary}" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="12,40,12,0" Visibility="Collapsed" />

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddButton" Style="{StaticResource AccentIconButton}" Tag="&#xE710;" Content="新增"
                                HorizontalAlignment="Stretch" Click="AddClick" ToolTip="新增一个 API Key（Ctrl+N）" />
                        <Button x:Name="ImportButton" Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE896;"
                                Content="导入环境变量" HorizontalAlignment="Stretch" Click="ImportClick"
                                ToolTip="把 Windows 用户环境变量里已有的 Key 收进来" />
                    </Grid>
                </Grid>
            </Border>

            <!-- right side -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,16,4">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Tag="&#xE713;" Content="设置"
                            Click="SettingsClick" Margin="0,0,8,0" />
                    <Button x:Name="LockButton" Style="{StaticResource IconButton}" Tag="&#xE72E;" Content="锁定" Click="LockClick"
                            ToolTip="立即锁定（Ctrl+L）" />
                </StackPanel>

                <!-- empty -->
                <StackPanel x:Name="EmptyView" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="40,0,40,60" MaxWidth="420">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D7;" FontSize="44" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="还没有保存任何 API Key" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" TextAlignment="Center"
                               Text="点左下角「新增」粘贴一个 Key，或者「从环境变量导入」把电脑里已经设置过的 Key 收进来。" />
                </StackPanel>

                <!-- detail -->
                <ScrollViewer x:Name="DetailView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,6,32,28" MaxWidth="780">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="{Binding Color}">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Provider}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Tag="&#xE70F;" Content="编辑" Click="EditClick" Margin="0,0,8,0" />
                                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Tag="&#xE74D;" Content="删除" Click="DeleteClick" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="API KEY" Style="{StaticResource Caption}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="KeyText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="15" VerticalContentAlignment="Center"
                                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                             VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="RevealButton" Click="RevealClick" ToolTip="显示 / 隐藏" AutomationProperties.Name="显示或隐藏 Key" Padding="10,7" Margin="0,0,8,0">
                                            <TextBlock x:Name="RevealGlyph" Style="{StaticResource Glyph}" Text="&#xE890;" />
                                        </Button>
                                        <Button x:Name="CopyKeyButton" Style="{StaticResource AccentIconButton}" Tag="&#xE8C8;"
                                                Content="复制" Click="CopyKeyClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BaseUrlCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BASE URL" Style="{StaticResource Caption}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BaseUrl, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                             VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Tag="&#xE8C8;" Content="复制"
                                            Click="CopyBaseUrlClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="EnvCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="环境变量" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EnvVar, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                         FontSize="15" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Style="{StaticResource IconButton}" Tag="&#xE756;" Content="复制 PowerShell 行"
                                            Click="CopyPowerShellClick" Margin="0,0,8,6" />
                                    <Button Style="{StaticResource IconButton}" Tag="&#xE756;" Content="复制 Bash 行"
                                            Click="CopyBashClick" Margin="0,0,8,6" />
                                    <Button Style="{StaticResource IconButton}" Tag="&#xE8A5;" Content="复制 .env 行"
                                            Click="CopyDotEnvClick" Margin="0,0,8,6" />
                                    <Button x:Name="WriteEnvButton" Style="{StaticResource IconButton}" Tag="&#xE7EF;"
                                            Content="写入用户环境变量" Click="WriteEnvClick" Margin="0,0,8,6" />
                                </WrapPanel>
                                <TextBlock x:Name="EnvStatus" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConsoleCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="控制台" Style="{StaticResource Caption}" />
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Hyperlink x:Name="ConsoleLink" Click="ConsoleLinkClick">
                                        <Run Text="{Binding ConsoleUrl, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NotesCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="备注" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="连接测试" Style="{StaticResource Caption}" />
                                <DockPanel>
                                    <Button x:Name="TestButton" Style="{StaticResource IconButton}" Tag="&#xE945;" Content="测试这个 Key"
                                            Click="TestClick" DockPanel.Dock="Left" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TestResultText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </DockPanel>
                                <TextBlock x:Name="TestHint" Style="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0"
                                           Text="只在你点击时，向服务商发一次只读请求（列出模型 / 查询账号），不会产生费用。" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="MetaText" FontSize="12" Margin="4,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- edit -->
                <ScrollViewer x:Name="EditView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="32,6,32,28" MaxWidth="720">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditTitle" Text="新增 API Key" FontSize="24" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SaveButton" Style="{StaticResource AccentIconButton}" Tag="&#xE74E;" Content="保存"
                                        Click="SaveEditClick" Padding="16,6" Margin="0,0,8,0" ToolTip="保存（Ctrl+S）" />
                                <Button x:Name="CancelButton" Content="取消" Click="CancelEditClick" Padding="16,6" ToolTip="取消（Esc）" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EditError" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                        <TextBlock Text="API Key（必填）" Style="{StaticResource FieldCaption}" />
                        <TextBox x:Name="KeyInput" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" TextChanged="KeyInputChanged" />
                        <TextBlock x:Name="KeyGuessHint" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="服务商" Style="{StaticResource FieldCaption}" />
                                <ComboBox x:Name="ProviderBox" IsEditable="True" HorizontalAlignment="Stretch"
                                          Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="名称（如「DeepSeek 主账号」）" Style="{StaticResource FieldCaption}" />
                                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Base URL（可选）" Style="{StaticResource FieldCaption}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="环境变量名（可选）" Style="{StaticResource FieldCaption}" />
                                <TextBox Text="{Binding EnvVar, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="控制台网址（可选）" Style="{StaticResource FieldCaption}" />
                                <TextBox Text="{Binding ConsoleUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="备注（账号、额度、用在哪个项目…）" Style="{StaticResource FieldCaption}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>

                <!-- toast -->
                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                        Padding="16,9" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,1,10,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="ToastText" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
