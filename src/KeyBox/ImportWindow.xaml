<Window x:Class="KeyBox.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从环境变量导入" Width="640" Height="540" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/KeyBox.ico">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="从环境变量导入" FontSize="22" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="下面是 Windows 用户环境变量里看起来像 Key 的条目（变量名里有 KEY、TOKEN、SECRET 等）。勾选要收进密钥匣的；环境变量本身不会被改动。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanImport}" VerticalContentAlignment="Center">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Masked}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="NoneText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="没找到像 Key 的用户环境变量。&#10;可以回到主界面点「新增」手动粘贴。" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ImportButton" Style="{StaticResource AccentButtonStyle}" Content="导入所选" Padding="18,6"
                    Margin="0,0,8,0" Click="ImportClick" IsDefault="True" />
            <Button Content="取消" Padding="18,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
