<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the real KeyBox.exe through UI Automation and saves window screenshots.
       Run: dotnet run (project tests/KeyBox.UiSmoke), passing the path to KeyBox.exe and a screenshot folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
